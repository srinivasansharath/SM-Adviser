# Copy to alert.env and edit. Non-secret alerting config — the SMTP app password lives ONLY
# in ~/.msmtprc (chmod 600), never here and never in git.
#
# alert.env itself is gitignored (it matches *.env), so it exists only on the server's disk.
# This template is tracked so a new server can be rebuilt without archaeology.

ALERT_TO="you@example.com"
ALERT_FROM="you@example.com"     # must match the 'from'/'user' in ~/.msmtprc
HOST_LABEL="my-server (hostname / tailnet-ip)"

# --- Paths (macOS values shown; Linux equivalents commented) ---
MSMTP_CONFIG="/Users/you/.msmtprc"
# MSMTP_CONFIG="/home/you/.msmtprc"
STATE_DIR="/Users/you/Library/Application Support/sm-adviser-monitor"
# STATE_DIR="/home/you/.local/state/sm-adviser-monitor"
SMA_ENV="/Users/you/sm-adviser/.env"                        # source of WIDGET_API_TOKEN (to auth /status)
WIDGET_JSON="/Users/you/sm-adviser/reports_out/widget.json"

# --- What the watchdog checks ---
API_URL="http://localhost:8787/health"
STATUS_URL="http://localhost:8787/status"   # authed: connector health + LLM token/cost spend
DB_CONTAINER="sm-adviser-db"
API_CONTAINER="sm-adviser-api"
STALE_HOURS="90"        # widget.json older than this => daily run likely stopped (clears a weekend)
DISK_FREE_GB_MIN="15"   # alert when / has less than this much FREE space (GiB).
                        # Absolute, not percent-full: a desktop holding a photo library can sit
                        # at 90%+ forever while still having plenty of room for the stack.
# The monthly LLM-budget nudge is driven server-side by MONTHLY_BUDGET_USD in $SMA_ENV; when the
# month's estimated spend crosses it, /status reports over_budget and the watchdog emails once.
