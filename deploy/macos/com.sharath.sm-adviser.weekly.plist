<?xml version="1.0" encoding="UTF-8"?>
<!-- Weekly new-stock screener, Sunday 07:00 IST — a fresh shortlist before the trading week.
     Weekday 0 is Sunday in launchd. Missed runs re-fire on wake (Persistent=true equivalent). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sharath.sm-adviser.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SMA_REPO__/deploy/macos/sma-job.sh</string>
    <string>weekly-screen</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__SMA_REPO__</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__SMA_HOME__/Library/Logs/sm-adviser/launchd-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>__SMA_HOME__/Library/Logs/sm-adviser/launchd-weekly.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
